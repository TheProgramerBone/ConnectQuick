<?xml version="1.0" encoding="utf-8"?>
<!--
  Release behaviour: TLS only. The relay carries opaque end-to-end encrypted frames, but pairing and
  signalling metadata should still not travel in clear text over the internet, so wss:// is required.
  The debug build overrides this file (src/debug/res/xml/network_security_config.xml) to allow ws://
  for local development against a backend started without certificates.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false" />
</network-security-config>
