<Project Sdk="Microsoft.NET.Sdk">

  <!-- Tests target the platform-neutral Core, so the whole suite runs on Linux CI as well as Windows. -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.0" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.8.0" />
    <PackageReference Include="NSec.Cryptography" Version="25.4.0" />
    <PackageReference Include="xunit" Version="2.5.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.5.3" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ConnectQuick.WindowsHost.Core\ConnectQuick.WindowsHost.Core.csproj" />
    <ProjectReference Include="..\ConnectQuick.WindowsHost.Testing\ConnectQuick.WindowsHost.Testing.csproj" />
    <ProjectReference Include="..\ConnectQuick.WindowsHost.Streaming\ConnectQuick.WindowsHost.Streaming.csproj" />
  </ItemGroup>

</Project>
