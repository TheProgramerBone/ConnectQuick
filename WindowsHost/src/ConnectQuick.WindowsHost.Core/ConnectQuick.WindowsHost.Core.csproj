<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Platform-neutral heart of the Host: protocol, cryptography, session handling and every
    feature service (input, clipboard, media, files, power, streaming signalling). Windows-only
    calls (SendInput, clipboard, LockWorkStation, ...) sit behind interfaces and are implemented in
    guarded Win32* classes, so the whole library builds and is tested on any OS. The WinForms
    shell (ConnectQuick.WindowsHost) only adds UI on top.
  -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>ConnectQuick.WindowsHost</RootNamespace>
    <AssemblyName>ConnectQuick.WindowsHost.Core</AssemblyName>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <WarningsNotAsErrors>NU1701</WarningsNotAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="NSec.Cryptography" Version="25.4.0" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="10.0.12" />
  </ItemGroup>

  <ItemGroup>
    <!-- The shared contract, embedded so the installed app validates against the very same schema the other platforms use. -->
    <EmbeddedResource Include="..\..\..\Protocol\schemas\session-messages.schema.json" LogicalName="session-messages.schema.json" Link="Protocol\session-messages.schema.json" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="ConnectQuick.WindowsHost.Tests" />
  </ItemGroup>

</Project>
